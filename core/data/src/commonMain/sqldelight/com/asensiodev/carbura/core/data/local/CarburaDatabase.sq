CREATE TABLE vehicles (
    id TEXT NOT NULL,
    familyId TEXT NOT NULL,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    brand TEXT,
    model TEXT,
    licensePlate TEXT,
    currentOdometerKm INTEGER NOT NULL,
    nextItvDate TEXT,
    insuranceRenewalDate TEXT,
    nextServiceOdometerKm INTEGER,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    pendingSync INTEGER NOT NULL DEFAULT 0,
    deletedAt INTEGER,
    PRIMARY KEY (familyId, id)
);

selectVehiclesByFamily:
SELECT *
FROM vehicles
WHERE familyId = ?
AND deletedAt IS NULL
ORDER BY name ASC;

selectPendingSyncVehicles:
SELECT *
FROM vehicles
WHERE familyId = ? AND pendingSync = 1;

selectSyncVehiclesByFamily:
SELECT *
FROM vehicles
WHERE familyId = ?;

deleteVehiclesByFamilyImmediately:
DELETE FROM vehicles
WHERE familyId = ?;

upsertVehicle:
INSERT OR REPLACE INTO vehicles(
    id,
    familyId,
    name,
    type,
    brand,
    model,
    licensePlate,
    currentOdometerKm,
    nextItvDate,
    insuranceRenewalDate,
    nextServiceOdometerKm,
    updatedAt,
    pendingSync,
    deletedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

markVehicleSynced:
UPDATE vehicles
SET pendingSync = 0
WHERE familyId = ? AND id = ? AND updatedAt = ? AND pendingSync = 1;

moveVehicleToFamily:
UPDATE vehicles SET id = ?, familyId = ? WHERE familyId = ? AND id = ?;

deleteVehicle:
UPDATE vehicles
SET deletedAt = ?,
    updatedAt = ?,
    pendingSync = 1
WHERE familyId = ? AND id = ?;

CREATE TABLE maintenanceRecords (
    id TEXT NOT NULL,
    familyId TEXT NOT NULL,
    vehicleId TEXT NOT NULL,
    maintenanceTypeId TEXT NOT NULL,
    maintenanceTypeCode TEXT,
    maintenanceTypeLabel TEXT,
    performedOn TEXT NOT NULL,
    odometerKm INTEGER,
    costCents INTEGER,
    currency TEXT NOT NULL,
    workshop TEXT,
    notes TEXT,
    nextDueDate TEXT,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    pendingSync INTEGER NOT NULL DEFAULT 0,
    deletedAt INTEGER,
    PRIMARY KEY (familyId, id)
);

selectMaintenanceRecordsByVehicle:
SELECT *
FROM maintenanceRecords
WHERE familyId = ? AND vehicleId = ?
AND deletedAt IS NULL
ORDER BY performedOn DESC;

selectActiveMaintenanceRecord:
SELECT *
FROM maintenanceRecords
WHERE id = ?
AND familyId = ?
AND vehicleId = ?
AND deletedAt IS NULL;

selectPendingSyncMaintenanceRecords:
SELECT *
FROM maintenanceRecords
WHERE familyId = ? AND pendingSync = 1;

selectSyncMaintenanceRecordsByFamily:
SELECT *
FROM maintenanceRecords
WHERE familyId = ?;

deleteMaintenanceRecordsByFamilyImmediately:
DELETE FROM maintenanceRecords
WHERE familyId = ?;

upsertMaintenanceRecord:
INSERT OR REPLACE INTO maintenanceRecords(
    id,
    familyId,
    vehicleId,
    maintenanceTypeId,
    maintenanceTypeCode,
    maintenanceTypeLabel,
    performedOn,
    odometerKm,
    costCents,
    currency,
    workshop,
    notes,
    nextDueDate,
    updatedAt,
    pendingSync,
    deletedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateMaintenanceRecord:
UPDATE maintenanceRecords
SET maintenanceTypeId = ?,
    maintenanceTypeCode = ?,
    maintenanceTypeLabel = ?,
    performedOn = ?,
    odometerKm = ?,
    costCents = ?,
    workshop = ?,
    notes = ?,
    nextDueDate = ?,
    updatedAt = ?,
    pendingSync = 1
WHERE id = ?
AND familyId = ?
AND vehicleId = ?
AND deletedAt IS NULL;

deleteMaintenanceRecordsByVehicle:
UPDATE maintenanceRecords
SET deletedAt = ?,
    updatedAt = ?,
    pendingSync = 1
WHERE familyId = ? AND vehicleId = ?
AND deletedAt IS NULL;

deleteMaintenanceRecord:
UPDATE maintenanceRecords
SET deletedAt = ?,
    updatedAt = ?,
    pendingSync = 1
WHERE familyId = ? AND id = ?;

markMaintenanceRecordSynced:
UPDATE maintenanceRecords
SET pendingSync = 0
WHERE familyId = ? AND id = ? AND updatedAt = ? AND pendingSync = 1;

moveMaintenanceRecordToFamily:
UPDATE maintenanceRecords SET id = ?, familyId = ?, vehicleId = ? WHERE familyId = ? AND id = ?;

CREATE TABLE reminders (
    id TEXT NOT NULL,
    familyId TEXT NOT NULL,
    vehicleId TEXT NOT NULL,
    maintenanceTypeId TEXT,
    title TEXT NOT NULL,
    dueDate TEXT,
    dueOdometerKm INTEGER,
    notifyDaysBefore INTEGER NOT NULL,
    isCompleted INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    pendingSync INTEGER NOT NULL DEFAULT 0,
    deletedAt INTEGER,
    PRIMARY KEY (familyId, id)
);

CREATE TABLE desiredNotificationOutbox (
    familyId TEXT NOT NULL,
    reminderId TEXT NOT NULL,
    action TEXT NOT NULL,
    payload TEXT,
    revision INTEGER NOT NULL,
    PRIMARY KEY (familyId, reminderId)
);

CREATE TABLE notificationRevisions (
    familyId TEXT NOT NULL,
    reminderId TEXT NOT NULL,
    revision INTEGER NOT NULL,
    PRIMARY KEY (familyId, reminderId)
);

selectNotificationRevision:
SELECT revision
FROM notificationRevisions
WHERE familyId = ? AND reminderId = ?;

replaceNotificationRevision:
INSERT OR REPLACE INTO notificationRevisions(familyId, reminderId, revision) VALUES (?, ?, ?);

replaceDesiredNotification:
INSERT OR REPLACE INTO desiredNotificationOutbox(familyId, reminderId, action, payload, revision) VALUES (?, ?, ?, ?, ?);

selectDesiredNotificationById:
SELECT *
FROM desiredNotificationOutbox
WHERE familyId = ? AND reminderId = ?;

selectDesiredNotifications:
SELECT *
FROM desiredNotificationOutbox WHERE familyId = ?
ORDER BY reminderId ASC;

acknowledgeDesiredNotification:
DELETE FROM desiredNotificationOutbox
WHERE familyId = ? AND reminderId = ?
AND revision = ?;

selectPendingRemindersByFamily:
SELECT *
FROM reminders
WHERE familyId = ?
AND isCompleted = 0
AND deletedAt IS NULL
ORDER BY COALESCE(dueDate, '9999-12-31') ASC,
         COALESCE(dueOdometerKm, 9223372036854775807) ASC,
         title ASC;

selectPendingSyncReminders:
SELECT *
FROM reminders
WHERE familyId = ? AND pendingSync = 1;

selectSyncRemindersByFamily:
SELECT *
FROM reminders
WHERE familyId = ?;

selectReminderById:
SELECT *
FROM reminders
WHERE familyId = ? AND id = ?;

selectActiveReminderById:
SELECT *
FROM reminders
WHERE familyId = ? AND id = ?
AND isCompleted = 0
AND deletedAt IS NULL;

selectAllReminders:
SELECT *
FROM reminders WHERE familyId = ?
ORDER BY id;

selectReminderIdsByFamilyForAccountCleanup:
SELECT id
FROM reminders
WHERE familyId = ?;

deleteRemindersByFamilyImmediately:
DELETE FROM reminders
WHERE familyId = ?;

selectSyncRemindersByVehicle:
SELECT *
FROM reminders
WHERE familyId = ? AND vehicleId = ?;

upsertReminder:
INSERT OR REPLACE INTO reminders(
    id,
    familyId,
    vehicleId,
    maintenanceTypeId,
    title,
    dueDate,
    dueOdometerKm,
    notifyDaysBefore,
    isCompleted,
    updatedAt,
    pendingSync,
    deletedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

markReminderCompleted:
UPDATE reminders
SET isCompleted = 1,
    updatedAt = ?,
    pendingSync = 1
WHERE familyId = ? AND id = ?;

deleteReminder:
UPDATE reminders
SET deletedAt = ?,
    updatedAt = ?,
    pendingSync = 1
WHERE familyId = ? AND id = ?;

deleteRemindersByVehicle:
UPDATE reminders
SET deletedAt = ?,
    updatedAt = ?,
    pendingSync = 1
WHERE familyId = ? AND vehicleId = ?
AND deletedAt IS NULL;

markReminderSynced:
UPDATE reminders
SET pendingSync = 0
WHERE familyId = ? AND id = ? AND updatedAt = ? AND pendingSync = 1;

moveReminderToFamily:
UPDATE reminders SET id = ?, familyId = ?, vehicleId = ? WHERE familyId = ? AND id = ?;

moveNotificationOutbox:
UPDATE desiredNotificationOutbox SET familyId = ?, reminderId = ?, payload = ? WHERE familyId = ? AND reminderId = ?;

moveNotificationRevision:
UPDATE notificationRevisions SET familyId = ?, reminderId = ? WHERE familyId = ? AND reminderId = ?;

CREATE TABLE activeFamilyScope (
    singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1),
    userId TEXT,
    familyId TEXT NOT NULL,
    generation INTEGER NOT NULL
);

selectActiveFamilyScope:
SELECT * FROM activeFamilyScope WHERE singleton = 1;

replaceActiveFamilyScope:
INSERT OR REPLACE INTO activeFamilyScope(singleton, userId, familyId, generation) VALUES (1, ?, ?, ?);

CREATE TABLE localDataDecisions (
    userId TEXT NOT NULL,
    familyId TEXT NOT NULL,
    snapshotDigest TEXT NOT NULL,
    decision TEXT NOT NULL,
    PRIMARY KEY (userId, familyId, snapshotDigest)
);

selectLocalDataDecision:
SELECT decision FROM localDataDecisions WHERE userId = ? AND familyId = ? AND snapshotDigest = ?;

insertLocalDataDecision:
INSERT OR REPLACE INTO localDataDecisions(userId, familyId, snapshotDigest, decision) VALUES (?, ?, ?, ?);

selectUnresolvedLocalVehicles:
SELECT * FROM vehicles WHERE familyId = 'local-family' AND (deletedAt IS NULL OR pendingSync = 1) ORDER BY id;

selectUnresolvedLocalMaintenanceRecords:
SELECT * FROM maintenanceRecords WHERE familyId = 'local-family' AND (deletedAt IS NULL OR pendingSync = 1) ORDER BY id;

selectUnresolvedLocalReminders:
SELECT * FROM reminders WHERE familyId = 'local-family' AND (deletedAt IS NULL OR pendingSync = 1) ORDER BY id;

selectVehicleByFamilyAndId:
SELECT * FROM vehicles WHERE familyId = ? AND id = ?;

selectMaintenanceRecordByFamilyAndId:
SELECT * FROM maintenanceRecords WHERE familyId = ? AND id = ?;

selectReminderByFamilyAndId:
SELECT * FROM reminders WHERE familyId = ? AND id = ?;
