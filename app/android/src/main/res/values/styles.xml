<resources>
    <style name="Theme.Carbura" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/carbura_background</item>
        <item name="android:colorAccent">@color/carbura_primary</item>
        <item name="android:statusBarColor">@color/carbura_background</item>
        <item name="android:navigationBarColor">@color/carbura_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
